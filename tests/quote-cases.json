[
  {"name": "Ontario, tax on a half cent", "lines": [{"q": 1, "p": 18.50}], "taxes": [{"label": "HST", "rate": 13}],
   "expect": {"lines": [18.50], "subtotal": 18.50, "taxes": [2.41], "tax": 2.41, "total": 20.91}},
  {"name": "Ontario, a line on a half cent", "lines": [{"q": 1.5, "p": 33.33}], "taxes": [{"label": "HST", "rate": 13}],
   "expect": {"lines": [50.00], "subtotal": 50.00, "taxes": [6.50], "tax": 6.50, "total": 56.50}},
  {"name": "Ontario, the line rounds before the tax", "lines": [{"q": 1.5, "p": 89.99}], "taxes": [{"label": "HST", "rate": 13}],
   "expect": {"lines": [134.99], "subtotal": 134.99, "taxes": [17.55], "tax": 17.55, "total": 152.54}},
  {"name": "Alberta, five percent of 2.90", "lines": [{"q": 1, "p": 2.90}], "taxes": [{"label": "GST", "rate": 5}],
   "expect": {"lines": [2.90], "subtotal": 2.90, "taxes": [0.15], "tax": 0.15, "total": 3.05}},
  {"name": "BC, three lines and two taxes, every one on a half cent", "lines": [{"q": 2.5, "p": 19.99}, {"q": 0.5, "p": 45.55}, {"q": 1, "p": 27.74}],
   "taxes": [{"label": "GST", "rate": 5}, {"label": "PST", "rate": 7}],
   "expect": {"lines": [49.98, 22.78, 27.74], "subtotal": 100.50, "taxes": [5.03, 7.04], "tax": 12.07, "total": 112.57}},
  {"name": "Quebec, two taxes", "lines": [{"q": 1, "p": 1000.05}], "taxes": [{"label": "GST", "rate": 5}, {"label": "QST", "rate": 9.975}],
   "expect": {"lines": [1000.05], "subtotal": 1000.05, "taxes": [50.00, 99.75], "tax": 149.75, "total": 1149.80}},
  {"name": "Ontario, an ordinary job", "lines": [{"q": 2, "p": 120}, {"q": 1, "p": 85}], "taxes": [{"label": "HST", "rate": 13}],
   "expect": {"lines": [240.00, 85.00], "subtotal": 325.00, "taxes": [42.25], "tax": 42.25, "total": 367.25}},
  {"name": "Hours and a price typed with three decimals", "lines": [{"q": 1.333, "p": 33.335}], "taxes": [{"label": "HST", "rate": 13}],
   "expect": {"lines": [44.34], "subtotal": 44.34, "taxes": [5.76], "tax": 5.76, "total": 50.10}},
  {"name": "A large job in Quebec", "lines": [{"q": 3, "p": 99999.99}], "taxes": [{"label": "GST", "rate": 5}, {"label": "QST", "rate": 9.975}],
   "expect": {"lines": [299999.97], "subtotal": 299999.97, "taxes": [15000.00, 29925.00], "tax": 44925.00, "total": 344924.97}},
  {"name": "Not registered for tax", "lines": [{"q": 0.25, "p": 89.98}], "taxes": [],
   "expect": {"lines": [22.50], "subtotal": 22.50, "taxes": [], "tax": 0.00, "total": 22.50}},
  {"name": "An optional line ticked, one left out",
   "lines": [{"q": 1, "p": 100}, {"q": 1.5, "p": 33.33, "optional": true, "ticked": true}, {"q": 1, "p": 10, "optional": true}],
   "taxes": [{"label": "HST", "rate": 13}],
   "expect": {"lines": [100.00, 50.00, 10.00], "subtotal": 150.00, "taxes": [19.50], "tax": 19.50, "total": 169.50}}
]
